---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

const { title, description, structuredData } = Astro.props;
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <div class="content-page">
    <SiteHeader />
    <main id="main-content">
      <span id="mobile-main-content"></span>
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style is:global>
  .content-page {
    color: #0f172a;
    background: #fff;
    font-family: 'Public Sans', system-ui, sans-serif;
    font-size: 16px;
  }

  .content-page h1,
  .content-page h2,
  .content-page h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .editorial-section {
    padding: 68px 32px;
  }

  .editorial-section--soft {
    background: #f7f5f2;
  }

  .editorial-section__inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .editorial-section__heading {
    max-width: 720px;
    margin-bottom: 32px;
  }

  .editorial-section__heading::before {
    display: block;
    width: 72px;
    height: 5px;
    margin-bottom: 18px;
    background: linear-gradient(90deg, #c8102e 0 34%, #1d3fa8 34% 100%);
    content: '';
  }

  .editorial-section__heading h2 {
    margin: 0;
    color: #0a1b44;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1.1;
  }

  .editorial-section__heading p,
  .editorial-copy {
    color: #475569;
    font-size: 16px;
    line-height: 1.75;
  }

  .editorial-section__heading p {
    margin: 14px 0 0;
  }

  .editorial-copy p {
    margin: 0 0 16px;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 20px;
  }

  .editorial-card {
    padding: 24px;
    border-top: 3px solid #1d3fa8;
    background: #fff;
    box-shadow: 0 10px 28px rgb(10 27 68 / 6%);
  }

  .editorial-card:nth-child(odd) {
    border-top-color: #c8102e;
  }

  .editorial-card h3 {
    margin: 0 0 10px;
    color: #0a1b44;
    font-size: 22px;
    line-height: 1.2;
  }

  .editorial-card p {
    margin: 0;
    color: #475569;
    font-size: 14px;
    line-height: 1.7;
  }

  .editorial-card a {
    display: inline-flex;
    margin-top: 16px;
    color: #1d3fa8;
    font-size: 14px;
    font-weight: 800;
    text-underline-offset: 3px;
  }

  .editorial-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 22px;
    color: #334155;
    line-height: 1.7;
  }

  .editorial-steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .editorial-steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid #d5dbe6;
  }

  .editorial-steps li:first-child {
    border-top: 1px solid #d5dbe6;
  }

  .editorial-steps__number {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    background: #0a1b44;
    color: #fff;
    font-weight: 800;
  }

  .editorial-steps h3 {
    margin: 0 0 6px;
    color: #0a1b44;
    font-family: 'Public Sans', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0;
  }

  .editorial-steps p {
    margin: 0;
    color: #475569;
    font-size: 14px;
    line-height: 1.65;
  }

  .editorial-faq {
    border-top: 1px solid #d5dbe6;
  }

  .editorial-faq details {
    margin: 0;
    padding: 18px 0;
    border: 0;
    border-bottom: 1px solid #d5dbe6;
    background: transparent;
  }

  .editorial-faq summary {
    color: #0a1b44;
    cursor: pointer;
    font-size: 17px;
    font-weight: 800;
  }

  .editorial-faq details p {
    max-width: 820px;
    margin: 12px 0 0;
    color: #475569;
    line-height: 1.7;
  }

  .editorial-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    border-left: 4px solid #c8102e;
    background: #f7f5f2;
  }

  .editorial-callout h2 {
    margin: 0;
    color: #0a1b44;
    font-size: clamp(26px, 3vw, 34px);
  }

  .editorial-callout p {
    margin: 8px 0 0;
    color: #475569;
    line-height: 1.6;
  }

  .editorial-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    background: #c8102e;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .editorial-button:hover {
    background: #a20d25;
  }

  .editorial-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 32px 0;
    color: #64748b;
    font-size: 13px;
  }

  .editorial-breadcrumbs a {
    color: #1d3fa8;
    text-underline-offset: 2px;
  }

  .editorial-provenance {
    padding-top: 18px;
    border-top: 1px solid #e5e7eb;
    color: #64748b;
    font-size: 13px;
    line-height: 1.6;
  }

  .editorial-provenance a {
    color: #1d3fa8;
    text-underline-offset: 2px;
  }

  @media (max-width: 720px) {
    .editorial-section {
      padding: 48px 20px;
    }

    .editorial-section__heading {
      margin-bottom: 24px;
    }

    .editorial-card {
      padding: 20px;
    }

    .editorial-callout {
      padding: 22px;
    }

    .editorial-breadcrumbs {
      padding: 16px 20px 0;
    }
  }
</style>
