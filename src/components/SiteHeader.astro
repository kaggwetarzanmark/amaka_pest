---
import { designHeaderMarkup } from '../data/designSource.js';
import { mobileHeaderMarkup } from '../data/mobileDesignSource.js';

const { desktop = true, mobile = true } = Astro.props;
---

{desktop && <div class="design-source-header" set:html={designHeaderMarkup}></div>}
{mobile && <div class="mobile-source-header" set:html={mobileHeaderMarkup}></div>}

<style is:global>
  .site-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .site-brand__logo {
    display: block;
    width: 58px;
    height: 58px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
  }

  .site-brand__wordmark {
    display: flex;
    flex-direction: column;
    color: #0a1b44;
    font-size: 15px;
    line-height: 1.08;
    white-space: nowrap;
  }

  .site-brand__wordmark strong {
    font-weight: 800;
  }

  .site-brand__wordmark strong:first-child {
    font-size: 17px;
  }

  .site-brand__service {
    color: #c8102e;
    font-size: 9px;
    letter-spacing: 0.14em;
  }

  .services-dropdown {
    position: relative;
  }

  .services-dropdown > summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #0a1b44;
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
    list-style: none;
    text-decoration: none;
  }

  .services-dropdown > summary::-webkit-details-marker,
  .mobile-services-dropdown > summary::-webkit-details-marker {
    display: none;
  }

  .services-dropdown > summary::after {
    width: 7px;
    height: 7px;
    transform: translateY(-2px) rotate(45deg);
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    content: '';
    transition: transform 140ms ease;
  }

  .services-dropdown[open] > summary::after {
    transform: translateY(2px) rotate(225deg);
  }

  .services-dropdown__menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 28px);
    left: -18px;
    display: none;
    width: 288px;
    max-height: min(70vh, 500px);
    overflow-y: auto;
    padding: 8px;
    border-top: 3px solid #c8102e;
    background: #fff;
    box-shadow: 0 14px 28px rgb(10 27 68 / 18%);
  }

  .services-dropdown[open] .services-dropdown__menu {
    display: grid;
  }

  .services-dropdown__link {
    display: flex;
    min-height: 42px;
    align-items: center;
    padding: 10px 12px;
    color: #0a1b44;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }

  .services-dropdown__link:hover,
  .services-dropdown__link:focus-visible {
    background: #f7f5f2;
    color: #c8102e;
  }

  .services-dropdown__link--overview {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #e5e7eb;
    color: #1d3fa8;
  }

  .services-dropdown__link--overview span {
    color: #64748b;
    font-size: 11px;
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .mobile-design .site-brand {
      gap: 9px;
    }

    .mobile-design .site-brand__logo {
      width: 42px;
      height: 42px;
    }

    .mobile-design .site-brand__wordmark {
      font-size: 12px;
    }

    .mobile-design .site-brand__wordmark strong:first-child {
      font-size: 16px;
    }

    .mobile-services-dropdown > summary {
      display: block;
      padding: 14px 8px;
      border-bottom: 1px solid #e8edf7;
      color: #0a1b44;
      cursor: pointer;
      font-weight: 700;
      list-style: none;
    }

    .mobile-services-dropdown[open] > summary {
      color: #c8102e;
    }

    .mobile-services-dropdown__links {
      display: grid;
      padding-left: 12px;
      border-bottom: 1px solid #e8edf7;
    }

    .mobile-services-dropdown__links a {
      padding: 11px 8px;
      font-size: 14px;
    }
  }
</style>
