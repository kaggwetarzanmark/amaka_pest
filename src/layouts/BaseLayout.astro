---
import '../styles/global.css';
import '../styles/responsive.css';
import '../styles/mobile-reference.css';
import '../styles/animations.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

const {
  title = 'Pest Control & Fumigation Across Uganda | Amata Pests Control Heroes',
  description = 'Nationwide pest control and fumigation for homes, hotels and businesses across Uganda. Cockroaches, bed bugs, termites, rodents and snakes. Clear quotes before work starts.',
} = Astro.props;
---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102451" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Public+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={Astro.url.pathname === '/' ? 'home-page' : undefined}>
    <a class="skip-link desktop-skip-link" href="#main-content">Skip to content</a>
    <a class="skip-link mobile-skip-link" href="#mobile-main-content">Skip to content</a>
    <slot />
    <FloatingWhatsApp />
    <script>
      import { animate, inView } from 'motion';

      const revealTargets = document.querySelectorAll(
        '.design-source-sections > section, .mobile-design section',
      );

      const menuButton = document.querySelector('.mobile-menu-toggle');
      const mobileMenu = document.querySelector('#mobile-site-nav');

      if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
        const closeMenu = () => {
          mobileMenu.hidden = true;
          menuButton.setAttribute('aria-expanded', 'false');
          menuButton.setAttribute('aria-label', 'Open menu');
        };

        menuButton.addEventListener('click', () => {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
          mobileMenu.hidden = isExpanded;
          menuButton.setAttribute('aria-expanded', String(!isExpanded));
          menuButton.setAttribute('aria-label', isExpanded ? 'Open menu' : 'Close menu');
        });

        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
            closeMenu();
            menuButton.focus();
          }
        });

        document.addEventListener('click', (event) => {
          if (
            event.target instanceof Node &&
            !mobileMenu.contains(event.target) &&
            !menuButton.contains(event.target)
          ) {
            closeMenu();
          }
        });
      }

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const revealedSections = new WeakSet<Element>();

        for (const target of revealTargets) {
          target.classList.add('motion-reveal');
          inView(
            target,
            (element) => {
              if (!revealedSections.has(element)) {
                revealedSections.add(element);
                animate(
                  element,
                  { opacity: [0, 1], y: [12, 0] },
                  { duration: 0.65, ease: [0.22, 1, 0.36, 1] },
                );
              }
            },
            { amount: 0.08, margin: '0px 0px -24px 0px' },
          );
        }
      }
    </script>
  </body>
</html>
