---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { designAboutMarkup } from '../data/designSource.js';
import { mobileAboutMarkup } from '../data/mobileDesignSource.js';
---

<BaseLayout title="About Amata Pests Control Heroes">
  <div class="desktop-design">
    <div
      class="design-page"
      style="font-family:'Public Sans',system-ui,sans-serif;color:#0F172A;background:#fff;font-size:17px"
    >
      <SiteHeader mobile={false} />
      <main id="main-content">
        <div class="design-source-sections" set:html={designAboutMarkup}></div>
      </main>
      <SiteFooter />
    </div>
  </div>
  <div id="mobile-main-content" class="mobile-design">
    <div
      class="design-page"
      style="font-family:'Public Sans',system-ui,sans-serif;color:#0F172A;background:#fff;font-size:16px"
    >
      <SiteHeader desktop={false} />
      <main>
        <div class="design-source-sections" set:html={mobileAboutMarkup}></div>
      </main>
      <SiteFooter />
    </div>
  </div>
</BaseLayout>
