---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignSections from '../components/DesignSections.astro';
import MobileDesign from '../components/MobileDesign.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout
  title="Pest Control & Fumigation Across Uganda | Amata Pests Control Heroes"
  description="Nationwide pest control and fumigation for homes, hotels and businesses across Uganda. Cockroaches, bed bugs, termites, rodents and snakes. Clear quotes before work starts."
>
  <div class="desktop-design">
    <div
      class="design-page"
      style="font-family:'Public Sans',system-ui,sans-serif;color:#0F172A;background:#fff;font-size:17px"
    >
      <SiteHeader mobile={false} />
      <main id="main-content">
        <DesignSections />
      </main>
      <SiteFooter />
    </div>
  </div>
  <MobileDesign />
</BaseLayout>
