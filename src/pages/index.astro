---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignSections from '../components/DesignSections.astro';
import MobileDesign from '../components/MobileDesign.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout
  title="Pest Control and Fumigation Services in Uganda | Amata"
  description="Need pest control or fumigation in Uganda? Ask Amata about termite, rodent, mosquito and bed bug services. Kampala-based; request a quote."
>
  <div class="desktop-design">
    <div
      class="design-page"
      style="font-family:'Public Sans',system-ui,sans-serif;color:#0F172A;background:#fff;font-size:17px"
    >
      <SiteHeader mobile={false} />
      <main id="main-content">
        <DesignSections />
      </main>
      <SiteFooter />
    </div>
  </div>
  <MobileDesign />
</BaseLayout>
